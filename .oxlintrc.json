{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "no-unused-vars": "warn",
    "typescript/no-explicit-any": "warn"
  },
  "ignorePatterns": [
    "dist",
    "node_modules"
  ]
}